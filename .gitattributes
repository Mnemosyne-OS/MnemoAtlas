# Text is stored LF and checked out however the contributor's platform wants it.
* text=auto eol=lf

# The geometry is gzipped binary. Git detects that on its own, and this says so
# out loud anyway: a line-ending normalisation applied to a .bin.gz does not
# fail, it produces a file that decompresses to nothing.
*.bin.gz binary
*.bin    binary
*.png    binary
*.jpg    binary
*.woff2  binary
